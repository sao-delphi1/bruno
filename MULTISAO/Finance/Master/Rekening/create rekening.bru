meta {
  name: create rekening
  type: http
  seq: 3
}

post {
  url: {{API_URL}}/rekening
  body: json
  auth: inherit
}

body:json {
  {
    "rekeningid" : "1",
    "rekeningname"  : "tes",
    "grouprekid": "110100",
    /* 
      tipe :
      1 = HARTA
      2 = KEWAJIBAN
      3 = MODAL
      4 = PENDAPATAN
      5 = BIAYA
    */
    "tipe" : "1",
    /*
      fgtipe :
      A = AKTIVA
      P = PASIVA
    */
    "fgtipe" : "A",
    "note" : "tes note",
    "fgactive" : "Y"
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
